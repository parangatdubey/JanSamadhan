# ==============================================================================
# JanSamadhan - Environment Variable Configuration Template
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and replace placeholder values.
# NEVER commit real credentials, passwords, or tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Database Configuration
# ------------------------------------------------------------------------------
DATABASE_NAME=jansamadhan_db
MONGODB_USER=your_atlas_db_username
MONGODB_HOST=your_cluster.mongodb.net
MONGODB_PASSWORD=your_atlas_db_password

# Or provide the full connection URI directly:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jansamadhan_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Server & Security Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Generate a strong 256-bit random key for production:
# Command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_256_bit_secret_key

# Comma-separated list of allowed frontend origins for CORS
# In production on Render/Vercel, specify your Vercel domain:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# ------------------------------------------------------------------------------
# 3. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# In development with Vite proxy: leave blank (defaults to relative /api)
# In production on Vercel: set to your Render backend URL (e.g. https://jansamadhan-backend.onrender.com)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Optional Integrations
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=

# Google Gemini API (Optional for LLM-powered multilingual AI pipeline)
GEMINI_API_KEY=

# SMTP Email Configuration (Optional for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JanSamadhan Grievance Redressal <noreply@jansamadhan.gov.in>"

# ------------------------------------------------------------------------------
# 5. Production Officer & Administrator Seeding (Used by seed script)
# ------------------------------------------------------------------------------
DEFAULT_OFFICER_PASSWORD=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

